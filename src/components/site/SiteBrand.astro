---
import { site } from '../../utils/site';

interface Props {
	class?: string;
	invert?: boolean;
}

const { class: className, invert = false } = Astro.props;
---

<a
	href="/"
	class:list={[
		'inline-flex min-h-12 items-center gap-3 no-underline transition-colors duration-200',
		invert
			? 'text-canvas hover:text-canvas/85'
			: 'text-md-on-surface hover:text-md-primary',
		className,
	]}
>
	<img
		src="/images/kevin-hatchoua-logo.png"
		alt=""
		class="size-10 shrink-0 rounded-full object-cover md:size-11"
		width="44"
		height="44"
		loading="eager"
		decoding="async"
	/>
	<span class="font-sans text-lg font-semibold tracking-tight">{site.name}</span>
</a>
