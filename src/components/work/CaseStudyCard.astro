---
interface Props {
	title: string;
	description: string;
	year: number;
	role: string;
	href: string;
	tags?: string[];
}

const { title, description, year, role, href, tags = [] } = Astro.props;
---

<article class="card-hover rounded-lg border border-border bg-canvas-elevated p-6 h-full flex flex-col">
	<div class="flex items-baseline justify-between gap-4">
		<p class="text-sm text-ink-subtle">{year}</p>
		<p class="text-sm font-medium text-accent">{role}</p>
	</div>
	<h2 class="mt-3 font-display text-2xl">
		<a href={href} class="text-ink no-underline hover:text-accent">{title}</a>
	</h2>
	<p class="mt-3 text-ink-muted flex-1">{description}</p>
	{
		tags.length > 0 && (
			<ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
				{tags.map((tag) => (
					<li class="rounded-full bg-accent-soft px-3 py-0.5 text-xs font-medium text-ink-muted">
						{tag}
					</li>
				))}
			</ul>
		)
	}
</article>
