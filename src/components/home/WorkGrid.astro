---
import FilterBadgeLink from '../ui/FilterBadgeLink.astro';
import { homeProjectFilterHref } from '../../utils/filterLinks';
import { categoryToFilterId } from '../../utils/site';
import { isLogoStyleHero, resolveWorkHeroImage } from '../../utils/workHero';
import { studioFilterIdsForArt } from '../../utils/studioArt';

export interface WorkGridProject {
	id: string;
	title: string;
	description: string;
	year: number;
	role: string;
	category: string;
	href: string;
	heroImage?: string;
	tags?: string[];
}

interface Props {
	projects: WorkGridProject[];
	/** Studio gallery: title-only cards */
	variant?: 'default' | 'studio';
}

const { projects, variant = 'default' } = Astro.props;
const studio = variant === 'studio';

const imageVersion = '4';

function heroSrc(path?: string) {
	const resolved = resolveWorkHeroImage(path);
	const joiner = resolved.includes('?') ? '&' : '?';
	return `${resolved}${joiner}v=${imageVersion}`;
}
---

<div id="home-projects" data-project-count={projects.length}>
	<ul class="grid grid-cols-1 gap-6 md:grid-cols-2" id="home-project-list" role="list">
		{
			projects.map((project) => {
				const filterId = categoryToFilterId[project.category] ?? 'ux-strategy';
				const studioFilterIds = studio
					? studioFilterIdsForArt(project.tags ?? [], project.id)
					: [];
				const resolvedHero = resolveWorkHeroImage(project.heroImage);
				const image = heroSrc(project.heroImage);
				const logoStyle = isLogoStyleHero(resolvedHero);
				return (
					<li
						class="project-card-wrapper"
						data-project-card
						data-project-id={project.id}
						data-category={filterId}
						data-studio-filters={studio ? studioFilterIds.join(' ') : undefined}
					>
						<article
							class="project-card group flex h-full flex-col overflow-hidden rounded-2xl border border-md-outline-variant bg-md-surface-container-lowest shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
						>
							<div class="relative aspect-[16/10] overflow-hidden bg-md-surface-container">
								<a href={project.href} class="block h-full no-underline text-inherit">
									<img
										src={image}
										alt=""
										draggable="false"
										class:list={[
											'h-full w-full transition-transform duration-500 group-hover:scale-[1.03]',
											logoStyle ? 'object-contain p-6' : 'object-cover',
										]}
										loading="lazy"
										decoding="async"
									/>
								</a>
								{
									!studio && (
										<div class="absolute left-3 top-3 z-10">
											<FilterBadgeLink
												href={homeProjectFilterHref(filterId)}
												label={project.category}
												variant="overlay"
											/>
										</div>
									)
								}
							</div>
							<a
								href={project.href}
								class:list={[
									'flex flex-1 flex-col no-underline text-inherit',
									studio ? 'items-center justify-center p-6 text-center' : 'p-5',
								]}
							>
								{
									!studio && (
										<p class="font-sans text-xs font-medium text-md-on-surface-variant">
											{project.year}
											<span class="mx-2 text-md-outline" aria-hidden="true">·</span>
											{project.role}
										</p>
									)
								}
								<h3
									class:list={[
										'font-display font-semibold leading-snug text-md-on-surface group-hover:text-md-primary',
										studio ? 'text-xl' : 'mt-2 text-xl',
									]}
								>
									{project.title}
								</h3>
								{
									studio ? (
										<span
											class="mt-4 inline-flex min-h-12 w-fit items-center font-sans text-sm font-semibold text-md-primary"
										>
											View →
										</span>
									) : (
										<>
											<p class="mt-2 flex-1 font-sans text-sm leading-relaxed text-md-on-surface-variant">
												{project.description}
											</p>
											<span
												class="mt-4 inline-flex min-h-12 w-fit items-center font-sans text-sm font-semibold text-md-primary"
											>
												View →
											</span>
										</>
									)
								}
							</a>
						</article>
					</li>
				);
			})
		}
	</ul>
	<p class="sr-only" id="home-projects-status" aria-live="polite"></p>
</div>

<script>
	function initHomeProjects() {
		const root = document.getElementById('home-projects');
		if (!root) return;

		const cards = [...root.querySelectorAll<HTMLElement>('[data-project-card]')];
		const filterRoot =
			document.getElementById('home-filters') ?? document.getElementById('studio-filters');
		const isStudio = Boolean(document.getElementById('studio-filters'));
		const status = document.getElementById('home-projects-status');
		const filterParam = isStudio ? 'type' : 'filter';

		let activeFilter =
			new URLSearchParams(window.location.search).get(filterParam)?.trim() || 'all';

		if (!isStudio && activeFilter === 'art') {
			window.location.replace('/studio');
			return;
		}

		function syncFilterUrl(next: string) {
			const url = new URL(window.location.href);
			if (!next || next === 'all') {
				url.searchParams.delete(filterParam);
			} else {
				url.searchParams.set(filterParam, next);
			}
			window.history.replaceState({}, '', url);
		}

		function filteredCards() {
			return cards.filter((card) => {
				if (activeFilter === 'all') return true;
				if (isStudio) {
					const studioFilters = (card.dataset.studioFilters ?? '').split(/\s+/).filter(Boolean);
					return studioFilters.includes(activeFilter);
				}
				return card.dataset.category === activeFilter;
			});
		}

		function updateChips(next: string) {
			if (!filterRoot) return;
			filterRoot.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((chip) => {
				const isActive = chip.dataset.filter === next;
				chip.dataset.active = isActive ? 'true' : 'false';
				chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
			if (isStudio) {
				(window as Window & { syncStudioFilterIndicator?: () => void }).syncStudioFilterIndicator?.();
			} else {
				(window as Window & { syncHomeFilterIndicator?: () => void }).syncHomeFilterIndicator?.();
			}
		}

		function render() {
			const visible = filteredCards();
			cards.forEach((card) => {
				const show = visible.includes(card);
				card.hidden = !show;
				card.classList.toggle('project-card-reveal', show);
			});
			if (status) {
				status.textContent = `Showing ${visible.length} of ${cards.length} projects`;
			}
		}

		filterRoot?.addEventListener('click', (event) => {
			const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
			if (!target?.dataset.filter) return;
			activeFilter = target.dataset.filter;
			syncFilterUrl(activeFilter);
			updateChips(activeFilter);
			render();
		});

		updateChips(activeFilter);
		render();
		if (activeFilter !== 'all') {
			document.getElementById('home-projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	}

	initHomeProjects();
	document.addEventListener('astro:page-load', initHomeProjects);
</script>
