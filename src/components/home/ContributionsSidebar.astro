---
import { formatBlogDate } from '../../utils/format';
import { site } from '../../utils/site';
import type { GitHubContributionItem } from '../../utils/github';

interface Props {
	contributions: GitHubContributionItem[];
}

const { contributions } = Astro.props;
---

<aside aria-labelledby="latest-contributions-heading">
	<div
		class="overflow-hidden rounded-2xl border border-md-outline-variant bg-md-surface-container-lowest shadow-sm"
	>
		<div class="border-b border-md-outline-variant/60 px-5 py-4">
			<h2 id="latest-contributions-heading" class="font-display text-xl font-semibold text-md-on-surface">
				Latest contributions
			</h2>
			<p class="mt-1 font-sans text-sm text-md-on-surface-variant">Recent public work on GitHub.</p>
		</div>

		<ul class="max-h-[550px] overflow-y-auto px-2 py-2 [scrollbar-width:thin]" role="list">
			{
				contributions.length === 0 ? (
					<li class="px-3 py-4 font-sans text-sm text-md-on-surface-variant">
						No recent public activity to show. Check back after your next push or open source update.
					</li>
				) : (
					contributions.map((item) => (
						<li class="border-b border-md-outline-variant/40 last:border-b-0">
							<a
								href={item.href}
								class="group flex min-h-12 flex-col justify-center gap-1 rounded-xl px-3 py-3 no-underline transition-colors hover:bg-md-surface-container-high"
								rel="noopener noreferrer"
								target="_blank"
							>
								<time
									datetime={item.occurredAt.toISOString()}
									class="font-sans text-xs font-medium uppercase tracking-wide text-md-on-surface-variant"
								>
									{formatBlogDate(item.occurredAt)}
								</time>
								<span class="font-sans text-sm font-medium leading-snug text-md-on-surface group-hover:text-md-primary">
									{item.title}
								</span>
								<span class="font-sans text-xs font-semibold text-md-primary">
									{item.kind} · view →
								</span>
							</a>
						</li>
					))
				)
			}
		</ul>

		<div class="border-t border-md-outline-variant/60 px-5 py-4">
			<a
				href={site.githubUrl}
				class="inline-flex min-h-12 items-center font-sans text-sm font-semibold text-md-primary no-underline hover:text-md-primary-hover"
				rel="noopener noreferrer"
				target="_blank"
			>
				View on GitHub →
			</a>
		</div>
	</div>
</aside>
