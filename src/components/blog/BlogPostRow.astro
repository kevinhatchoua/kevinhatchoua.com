---
import PostMeta from './PostMeta.astro';
import { formatBlogDate } from '../../utils/format';

interface Props {
	href: string;
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	thumbnail: string;
	compact?: boolean;
}

const {
	href,
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	thumbnail,
	compact = false,
} = Astro.props;
---

{
	compact ? (
		<a
			href={href}
			class="blog-post-row group flex gap-3 rounded-xl px-2 py-2.5 no-underline text-inherit transition-colors hover:bg-md-surface-container-high"
		>
			<div
				class="blog-post-row__thumb size-[4.25rem] shrink-0 overflow-hidden rounded-xl border border-md-outline-variant/70 bg-md-surface-container"
			>
				<img
					src={thumbnail}
					alt=""
					class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="min-w-0 flex-1">
				<time
					datetime={pubDate.toISOString()}
					class="font-sans text-xs font-medium uppercase tracking-wide text-md-on-surface-variant"
				>
					{formatBlogDate(pubDate)}
				</time>
				<p class="mt-1 font-sans text-sm font-medium leading-snug text-md-on-surface group-hover:text-md-primary">
					{title}
				</p>
			</div>
		</a>
	) : (
		<article
			class="blog-post-row group relative flex gap-4 py-7 sm:gap-6 sm:py-8"
		>
			<a
				href={href}
				class="absolute inset-0 z-0 rounded-sm no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
				aria-label={`Read: ${title}`}
			/>
			<div
				class="blog-post-row__thumb relative z-[1] h-[5.5rem] w-[7.5rem] shrink-0 overflow-hidden rounded-xl border border-md-outline-variant/70 bg-md-surface-container pointer-events-none sm:h-[6.75rem] sm:w-[9.5rem]"
			>
				<img
					src={thumbnail}
					alt=""
					class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="relative z-[1] min-w-0 flex-1 pointer-events-none">
				<h2 class="font-display text-xl font-semibold leading-snug text-md-on-surface group-hover:text-md-primary sm:text-2xl">
					{title}
				</h2>
				{description && (
					<p class="mt-2 line-clamp-2 font-sans text-sm leading-relaxed text-md-on-surface-variant sm:text-base">
						{description}
					</p>
				)}
				<div class="relative z-[2] mt-3 pointer-events-auto">
					<PostMeta pubDate={pubDate} updatedDate={updatedDate} tags={tags} />
				</div>
			</div>
		</article>
	)
}
