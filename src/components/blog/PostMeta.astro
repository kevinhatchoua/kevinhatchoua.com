---
interface Props {
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
}

const { pubDate, updatedDate, tags = [] } = Astro.props;

const format = (date: Date) =>
	date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between text-sm text-ink-subtle">
	<div>
		<time datetime={pubDate.toISOString()}>{format(pubDate)}</time>
		{
			updatedDate && (
				<span>
					<span class="mx-2" aria-hidden="true">·</span>
					Updated <time datetime={updatedDate.toISOString()}>{format(updatedDate)}</time>
				</span>
			)
		}
	</div>
	{
		tags.length > 0 && (
			<ul class="flex flex-wrap gap-2" aria-label="Tags">
				{tags.map((tag) => (
					<li class="rounded-full border border-border px-2.5 py-0.5 text-xs">{tag}</li>
				))}
			</ul>
		)
	}
</div>
