---
import { studioFilters } from '../../utils/site';
---

<div class="mb-8 w-full" id="studio-filters" role="group" aria-label="Filter art by type">
	<div
		class="filter-track-scroll overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] md:overflow-visible [&::-webkit-scrollbar]:hidden"
	>
		<div
			id="studio-filters-track"
			class="filter-track relative mx-auto flex w-full min-w-max flex-row flex-nowrap items-stretch md:min-w-full"
		>
			<div
				id="studio-filter-indicator"
				class="filter-indicator pointer-events-none absolute left-0 top-0"
				aria-hidden="true"
			>
			</div>
			{
				studioFilters.map((filter, index) => (
					<button
						type="button"
						class="filter-chip"
						data-filter={filter.id}
						data-active={index === 0 ? 'true' : 'false'}
						aria-pressed={index === 0 ? 'true' : 'false'}
					>
						<span>{filter.label}</span>
					</button>
				))
			}
		</div>
	</div>
</div>

<script>
	function initStudioFilterBar() {
		const track = document.getElementById('studio-filters-track');
		if (!track) return;

		const positionIndicator = () => {
			const pill = document.getElementById('studio-filter-indicator');
			const active = track.querySelector<HTMLElement>('[data-filter][data-active="true"]');
			if (!pill || !active) return;

			const lineHeight = 2;
			pill.style.width = `${active.offsetWidth}px`;
			pill.style.height = `${lineHeight}px`;
			pill.style.transform = `translate3d(${active.offsetLeft}px, ${active.offsetTop + active.offsetHeight - lineHeight}px, 0)`;
		};

		(window as Window & { syncStudioFilterIndicator?: () => void }).syncStudioFilterIndicator =
			positionIndicator;

		const resizeObserver = new ResizeObserver(() => positionIndicator());
		resizeObserver.observe(track);
		track.querySelectorAll('[data-filter]').forEach((chip) => resizeObserver.observe(chip));

		window.addEventListener('resize', positionIndicator, { passive: true });
		requestAnimationFrame(positionIndicator);
	}

	initStudioFilterBar();
	document.addEventListener('astro:page-load', initStudioFilterBar);
</script>
