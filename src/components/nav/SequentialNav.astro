---
import type { SequentialNeighbor } from '../../utils/sequentialNav';

interface Props {
	prev: SequentialNeighbor | null;
	next: SequentialNeighbor | null;
	kind: 'post' | 'project' | 'studio';
}

const { prev, next, kind } = Astro.props;

const kindLabel =
	kind === 'post' ? 'post' : kind === 'studio' ? 'piece' : 'project';
const navLabel =
	kind === 'post' ? 'Blog' : kind === 'studio' ? 'Studio' : 'Work';
---

{
	(prev || next) && (
		<nav
			class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2 sm:gap-6"
			aria-label={`${navLabel} navigation`}
		>
			{prev ? (
				<a
					href={prev.href}
					class="group flex min-w-0 flex-col rounded-xl border border-border bg-canvas-elevated px-4 py-3 no-underline transition-colors hover:border-accent hover:text-accent"
				>
					<span class="text-xs font-semibold uppercase tracking-widest text-ink-subtle group-hover:text-accent">
						← Previous {kindLabel}
					</span>
					<span class="mt-1 font-display text-base font-semibold leading-snug text-ink group-hover:text-accent">
						{prev.title}
					</span>
				</a>
			) : null}
			{next ? (
				<a
					href={next.href}
					class:list={[
						'group flex min-w-0 flex-col rounded-xl border border-border bg-canvas-elevated px-4 py-3 text-right no-underline transition-colors hover:border-accent hover:text-accent',
						prev && 'sm:col-start-2',
						!prev && 'sm:col-span-2 sm:max-w-md sm:ml-auto',
					]}
				>
					<span class="text-xs font-semibold uppercase tracking-widest text-ink-subtle group-hover:text-accent">
						Next {kindLabel} →
					</span>
					<span class="mt-1 font-display text-base font-semibold leading-snug text-ink group-hover:text-accent">
						{next.title}
					</span>
				</a>
			) : null}
		</nav>
	)
}
