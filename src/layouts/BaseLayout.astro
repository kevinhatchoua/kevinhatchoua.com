---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import SkipLink from '../components/site/SkipLink.astro';
import { pageTitle, canonicalUrl } from '../utils/seo';

import ScrollStory from '../components/site/ScrollStory.astro';
import ScrollJump from '../components/site/ScrollJump.astro';
import ProseImageLightbox from '../components/media/ProseImageLightbox.astro';

interface Props {
	title: string;
	description?: string;
	path?: string;
	overlayNav?: boolean;
	hideSiteHeader?: boolean;
}

const {
	title,
	description,
	path = Astro.url.pathname,
	overlayNav = false,
	hideSiteHeader = false,
} = Astro.props;
const siteUrl = Astro.site?.href ?? 'https://kevinhatchou.com';
const fullTitle = pageTitle(title);
const metaDescription =
	description ?? 'Personal portfolio and writing by Kevin Hatchoua — design, education, and craft.';
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(function () {
				try {
					var dark = localStorage.getItem('theme') === 'dark';
					if (dark) document.documentElement.classList.add('dark');
					document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
				} catch (e) {}
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={metaDescription} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl(siteUrl, path)} />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
	</head>
	<body class="min-h-screen bg-md-surface">
		<div class="flex min-h-screen flex-col">
			<SkipLink />
			{!hideSiteHeader && <Header overlay={overlayNav} />}
			<main id="main-content" class="flex-1">
				<slot />
			</main>
			<Footer />
		</div>
		<ScrollStory />
		<ScrollJump />
		<ProseImageLightbox />
	</body>
</html>
