---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/blog/PostMeta.astro';
import SequentialNav from '../components/nav/SequentialNav.astro';
import type { SequentialNeighbors } from '../utils/sequentialNav';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags: string[];
	sequential?: SequentialNeighbors;
}

const { title, description, pubDate, updatedDate, tags, sequential } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<article class="page-shell section-gap max-w-3xl">
		<header class="mb-10 border-b border-border pb-8">
			<p class="text-sm font-medium uppercase tracking-widest text-ink-subtle">Blog</p>
			<h1 class="mt-3 max-w-none text-display-lg text-balance">{title}</h1>
			<p class="mt-4 text-lg text-ink-muted">{description}</p>
			<div class="mt-6">
				<PostMeta pubDate={pubDate} updatedDate={updatedDate} tags={tags} />
			</div>
		</header>
		<div class="prose prose-detail">
			<slot />
		</div>
		{sequential && <SequentialNav prev={sequential.prev} next={sequential.next} kind="post" />}
	</article>
</BaseLayout>
