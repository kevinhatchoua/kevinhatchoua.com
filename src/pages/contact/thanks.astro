---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import { projectsCrumb, crumb } from '../../utils/breadcrumbs';
---

<BaseLayout
	title="Message sent"
	description="Thanks for getting in touch with Kevin Hatchoua."
>
	<section class="page-shell section-gap max-w-xl">
		<Breadcrumbs
			items={[projectsCrumb, crumb('Contact', '/contact'), crumb('Thanks')]}
			class="mb-6"
		/>
		<h1 class="text-display-lg">Thanks for writing.</h1>
		<p class="mt-4 text-lg text-ink-muted">
			Your note is on its way. I read every message personally and will reply when I can.
		</p>
		<p class="mt-8">
			<a href="/" class="font-semibold text-accent no-underline hover:text-accent-hover">
				Back to home
			</a>
			<span class="mx-2 text-ink-subtle" aria-hidden="true">·</span>
			<a href="/contact" class="font-semibold text-accent no-underline hover:text-accent-hover">
				Send another message
			</a>
		</p>
	</section>
</BaseLayout>
